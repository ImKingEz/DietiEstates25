<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox style="-fx-cursor: hand;" styleClass="annuncioHBox" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.dietiestates25ui.controller.AnnuncioItemController">
    <children>
        <StackPane styleClass="annuncioImageStackPane">
            <children>
                <ImageView fx:id="annuncioImageView" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="annuncioImageView" />
            </children>
        </StackPane>
        <VBox styleClass="annuncioDetailVBox">
            <children>
                <Text fx:id="annuncioTitle" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="annuncioTitle" text="Titolo" />
                <Text fx:id="prezzoAnnuncio" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="prezzoAnnuncio" text="Prezzo" />
                <FlowPane fx:id="detailFlowPane" prefWrapLength="350.0" styleClass="detailAnnuncioFlowPane">
                    <children>
                        <HBox styleClass="detailWithIconHBox">
                            <children>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="iconDetailAnnuncio">
                                    <image>
                                        <Image url="@../images/roomIcon.png" />
                                    </image>
                                </ImageView>
                                <Text fx:id="textLocaliDetailAnnuncio" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="textDetailAnnuncio" text="3 locali" />
                            </children>
                        </HBox>
                        <HBox styleClass="detailWithIconHBox">
                            <children>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="iconDetailAnnuncio">
                                    <image>
                                        <Image url="@../images/superficieIcon.png" />
                                    </image>
                                </ImageView>
                                <Text fx:id="textSuperficieDetailAnnuncio" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="textDetailAnnuncio" text="120mq" />
                            </children>
                        </HBox>
                        <HBox styleClass="detailWithIconHBox">
                            <children>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="iconDetailAnnuncio">
                                    <image>
                                        <Image url="@../images/bathroomIcon.png" />
                                    </image>
                                </ImageView>
                                <Text fx:id="textBagniDetailAnnuncio" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="textDetailAnnuncio" text="2 bagni" />
                            </children>
                        </HBox>
                        <HBox styleClass="detailWithIconHBox">
                            <children>
                                <ImageView fx:id="imageVicinanzaDetailAnnuncio" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="iconDetailAnnuncio">
                                    <image>
                                        <Image url="@../images/schoolIcon.png" />
                                    </image>
                                </ImageView>
                                <Text fx:id="textVicinanzaDetailAnnuncio" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="textDetailAnnuncio" text="Scuola vicina" />
                            </children>
                        </HBox>
                    </children>
                </FlowPane>
                <HBox styleClass="annuncioButtonsHBox">
                    <children>
                        <Button fx:id="visitaButton" mnemonicParsing="false" styleClass="generalButton" text="Prenota una visita">
                            <graphic>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="iconDetailAnnuncio">
                                    <image>
                                        <Image url="@../images/calendarIcon.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="offertaButton" mnemonicParsing="false" styleClass="generalButton" text="Fai un'offerta">
                            <graphic>
                                <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="iconDetailAnnuncio">
                                    <image>
                                        <Image url="@../images/euroIcon.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</HBox>
